# Google Cloud Run Configuration
# Copy this file to .env.cloudrun and update with your values

# Required: Google Cloud Project ID
GCP_PROJECT_ID=your-project-id

# Cloud Run Region (default: us-central1)
# See available regions: https://cloud.google.com/run/docs/locations
GCP_REGION=us-central1

# Service name (default: biochubs-api)
SERVICE_NAME=biochubs-api

# Artifact Registry repository name (default: biochubs)
ARTIFACT_REGISTRY_REPO=biochubs

# Required: PostgreSQL connection string
# For Cloud SQL, use format: postgresql://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE
# For external database, use: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
POSTGRES_URI=postgresql://postgres:changeme@/hubs_dev?host=/cloudsql/your-project:us-central1:biochubs-db

# Optional: Cloud SQL instance connection name (format: PROJECT:REGION:INSTANCE)
# Only needed if using Cloud SQL
CLOUD_SQL_INSTANCE=your-project:us-central1:biochubs-db

# Scaling configuration
MIN_INSTANCES=0  # Set to 1+ to avoid cold starts
MAX_INSTANCES=10

# Resource limits
MEMORY=1Gi  # Options: 128Mi, 256Mi, 512Mi, 1Gi, 2Gi, 4Gi, 8Gi
CPU=1       # Options: 1, 2, 4, 6, 8

# Request timeout (seconds, max 3600)
TIMEOUT=300

# Authentication (true = public access, false = require authentication)
ALLOW_UNAUTHENTICATED=true

# Optional: Additional environment variables for the application
# LOG_LEVEL=info
